+def choose_lead(out: Path, style: str, hero_facts: list, topic_facts: list, topic_list: list, lean_by_id: dict,
+                quotes: list, date_facts: dict) -> list | None:
+    """The one place the day's most important event is decided, over the whole choice at once.
+
+    The topic choice reads the material in parts and each part only sees about a hundred facts, so what leads the report
+    would otherwise depend on which part held it and on the reading order (the first article's lead survived all six parts
+    on 2026-11-18 while the stock slump that moved the market most sat in two other parts and was never compared with it).
+    Here the model sees the facts the earlier choice kept, grouped by topic, with the closes of the stock and yield
+    indices and how many articles reported each fact, and answers with the fact ids at the centre of the day.
+    Returns those ids, or None when the model's answer cannot be used (the earlier choice then stands)."""
+    groups = ([hero_facts] if hero_facts else []) + list(topic_facts)
+    # The groups carry no title and no sign of which one the earlier choice put first: a label such as "ranked most
+    # important in the parts" is read by the model as the answer (2026-11-17 replay: it said so in its reasoning), and a
+    # topic title is the earlier choice's own wording. They are ordered by the largest number of articles that reported any
+    # of their facts, the cue the question names, so the order itself carries evidence rather than the earlier ranking.
+    def reported(facts):
+        return max([(lean_by_id.get(f["fact_id"]) or {}).get("報じた記事数", 0) for f in facts] or [0])
+    groups = sorted(groups, key=reported, reverse=True)
+    shown = [{"話題": chr(ord("A") + n), "facts": [lean_by_id.get(f["fact_id"], {"id": f["fact_id"], "fact": f["fact"]}) for f in facts]}
+             for n, facts in enumerate(groups)]
+    groups = [{"facts": facts} for facts in groups]
+    candidates = [f["fact_id"] for g in groups for f in g["facts"]]
+    if len(candidates) < 2:
+        return None
+    data = {"date_facts": date_facts, "選定の全体": shown, "前営業日の株・商品・金利の終値": [q["fact"] for q in quotes]}
+    task = (style + "前営業日の相場の振り返りの選定は、資料を何回かに分けて読んで作った。読んだ順番や、どの部分にあったかで重要度は決まらない。"
+            "ここでは選定の全体を見渡して、前営業日の相場を最も動かした出来事を一つ選び、その中心になるfactのid(1〜2件)を答える。"
+            "手がかりは、終値の変化や市場の反応の大きさと、factに付いた『報じた記事数』。答えは『選定の全体』にあるidだけ。")
+    schema = news.schema({"hero_ids": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "enum": candidates}}})
+    try:
+        answer = call(out, "oneshot-2c-lead", task, data, schema, 4000)
+    except Exception:
+        return None
+    ids = [i for i in dict.fromkeys(answer.get("hero_ids") or []) if i in candidates]
+    return ids or None
+
+
