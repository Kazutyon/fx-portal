+    def lead_run(self, lead_answer):
+        """Run generate with a fixed topic choice (hero = a, topics 甲/乙/丙) and the given answer to the lead call;
+        returns (sections, what the lead call was shown, gap items, ids a..e)."""
+        material, calendar, ranking = self.inputs()
+        events = [f for f in material if f["fact_id"].startswith("N") and not oneshot.is_view(f) and not oneshot.is_theme(f)]
+        a, b, c, d, e = events[:5]
+        seen = {}
+
+        def calls(out, label, task, data, schema, *rest):
+            if label.endswith("topics"):
+                return {"hero_ids": [a["fact_id"]], "summary_ids": [e["fact_id"]],
+                        "topics": [{"title": "甲", "fact_ids": [b["fact_id"], c["fact_id"]]},
+                                   {"title": "乙", "fact_ids": [d["fact_id"], events[5]["fact_id"]]}], "market_view_ids": []}
+            if label.endswith("lead"):
+                seen["data"], seen["schema"] = data, schema
+                return lead_answer(a, b, c, d)
+            return canned(out, label, task, data, schema)
+
+        with tempfile.TemporaryDirectory() as folder, patch.object(oneshot, "call", side_effect=calls):
+            out = Path(folder)
+            (out / "policy.json").write_text((RUN / "policy.json").read_text(encoding="utf-8"), encoding="utf-8")
+            (out / "quotes.json").write_text(json.dumps([{"fact_id": "Q0", "kind": "price", "event_scope": "previous", "record_type": "actual", "pairs": [], "fact": "2026-09-29のNYダウの終値は…", "quote": "2026-09-29のNYダウの終値は…", "source_title": "Yahoo", "source_url": "", "published_at": "", "source_context": {}}], ensure_ascii=False), encoding="utf-8")
+            oneshot.generate(out, date(2026, 9, 30), material, calendar, ranking, json.loads((out / "policy.json").read_text(encoding="utf-8")))
+            sections = json.loads((out / "sections.json").read_text(encoding="utf-8"))
+            gaps = [g["item"] for g in json.loads((out / "gaps.json").read_text(encoding="utf-8"))] if (out / "gaps.json").exists() else []
+        return sections, seen, gaps, (a, b, c, d, e)
+
+    def test_the_day_leads_with_the_event_chosen_over_the_whole_selection(self):
+        sections, seen, gaps, (a, b, c, d, e) = self.lead_run(lambda a, b, c, d: {"hero_ids": [d["fact_id"]]})
+        # the lead call saw every kept fact grouped by topic, the closes, and could answer only with those ids
+        # the groups are only lettered: neither a topic's title nor a "ranked most important" label shows what the earlier choice preferred
+        self.assertEqual([g["話題"] for g in seen["data"]["選定の全体"]], ["A", "B", "C"])
+        shown = json.dumps(seen["data"]["選定の全体"], ensure_ascii=False)
+        self.assertNotIn("最重要", shown)
+        self.assertNotIn('"甲"', shown)
+        self.assertEqual(seen["data"]["前営業日の株・商品・金利の終値"], ["2026-09-29のNYダウの終値は…"])
+        self.assertEqual(set(seen["schema"]["properties"]["hero_ids"]["items"]["enum"]),
+                         {f["id"] for g in seen["data"]["選定の全体"] for f in g["facts"]})
+        self.assertTrue({x["fact_id"] for x in (a, b, c, d)} <= set(seen["schema"]["properties"]["hero_ids"]["items"]["enum"]))
+        self.assertEqual(sections["hero"], oneshot.join_facts([d]))
+        self.assertEqual(sections["headline"], "乙")  # the topic holding the chosen fact leads and gives the headline
+        self.assertEqual([t["title"] for t in sections["topics"]], ["乙", "甲"])
+        self.assertNotIn(oneshot.join_facts([d]), sections["topics"][0]["body"])  # not repeated under its own topic
+        self.assertEqual(gaps.count("最重要の出来事の選定"), 0)
+
+    def test_an_unusable_lead_answer_keeps_the_earlier_choice_and_records_a_gap(self):
+        for answer in ({"hero_ids": ["NOPE"]}, {"hero_ids": []}, {"issues": []}):
+            sections, _, gaps, (a, *_rest) = self.lead_run(lambda a, b, c, d, answer=answer: answer)
+            self.assertEqual(sections["hero"], oneshot.join_facts([a]))
+            self.assertEqual(sections["headline"], "甲")
+            self.assertIn("最重要の出来事の選定", gaps)
+
